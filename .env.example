DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.localhost
HMS_ADMIN_HOST=admin.localhost
HMS_STAFF_HOST=staff.localhost
HMS_STORE_HOST=store.localhost
HMS_PATIENT_HOST=patient.localhost
HMS_AGENT_HOST=agent.localhost
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_SESSION_COOKIE_AGE=28800
# DJANGO_SESSION_COOKIE_DOMAIN=.example.com
# DJANGO_CSRF_COOKIE_DOMAIN=.example.com
DJANGO_EMAIL_HOST=smtp.resend.com
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_USER=resend
RESEND_FROM_EMAIL="Hospital Management System <noreply@example.com>"
